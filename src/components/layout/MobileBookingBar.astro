---
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
---

<div class="mobile-bar">
  <Button href={site.contact.whatsappHref} external bookingSlot="mobile-bar" class="mobile-bar__cta">
    {site.booking.label}
  </Button>
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-mobile-bar);
    display: flex;
    padding: 12px 14px calc(12px + env(safe-area-inset-bottom));
    background: rgb(251 247 243 / 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border-soft);
  }

  .mobile-bar :global(.mobile-bar__cta) {
    flex: 1;
    min-height: 52px;
    padding: 17px;
  }

  @media (min-width: 1080px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
