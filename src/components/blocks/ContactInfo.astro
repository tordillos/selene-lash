---
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import { site } from '@/config/site';
---

<Card tone="base" class="contact-info">
  <dl class="contact-info__list">
    <div>
      <dt>Dirección</dt>
      <dd>
        <address>
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city} · {site.address.district}
        </address>
      </dd>
    </div>
    <div>
      <dt>Horario</dt>
      <dd>
        {
          site.hours.lines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </dd>
    </div>
    <div>
      <dt>Contacto</dt>
      <dd class="contact-info__links">
        <a href={site.contact.phoneHref}>{site.contact.phone}</a><br />
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </dd>
    </div>
  </dl>

  <div class="contact-info__actions">
    <Button href={site.booking.href} block bookingSlot="contacto">{site.booking.label}</Button>
    <Button href={site.contact.whatsappHref} external block variant="outline">Escríbeme por WhatsApp</Button>
  </div>
</Card>

<style>
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: clamp(28px, 3.4vw, 46px);
  }

  .contact-info__list {
    display: flex;
    flex-direction: column;
    gap: 26px;
    margin: 0;
  }

  dt {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  dd {
    margin: 10px 0 0;
    font-size: 17px;
    line-height: 1.6;
    font-weight: 300;
  }

  address {
    font-style: normal;
  }

  .contact-info__links {
    line-height: 1.7;
  }

  .contact-info__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }

  .contact-info__actions :global(.btn--outline:hover) {
    background: #f1e6de;
  }
</style>
