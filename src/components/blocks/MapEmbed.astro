---
interface Props {
  /** src del iframe que da Google Maps en Compartir → Insertar un mapa. */
  src: string;
  title?: string;
}

const { src, title = 'Mapa de ubicación' } = Astro.props;
---

<div class="map" data-reveal>
  <iframe {src} {title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>

<style>
  .map {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.35) sepia(0.12);
  }
</style>
