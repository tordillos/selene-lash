---
import { site } from '@/config/site';

interface Props {
  size?: 'md' | 'lg';
  /** Texto bajo el nombre; `false` lo oculta. */
  tagline?: string | false;
  href?: string;
  class?: string;
}

const { size = 'md', tagline = site.tagline, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class:list={['logo', `logo--${size}`, className]}>
  <span class="logo__name">{site.name}</span>
  {tagline && <span class="logo__tagline">{tagline}</span>}
</Tag>

<style>
  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: inherit;
  }

  .logo:hover {
    color: inherit;
  }

  .logo__name {
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .logo--md .logo__name {
    font-size: 26px;
  }

  .logo--lg .logo__name {
    font-size: 30px;
  }

  .logo__tagline {
    font-size: 9px;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    opacity: 0.65;
    margin-top: 5px;
  }

  .logo--lg .logo__tagline {
    margin-top: 8px;
    opacity: 0.6;
  }
</style>
