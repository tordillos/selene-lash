---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', className]}><slot /></Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }
</style>
