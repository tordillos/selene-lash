---
/**
 * Imagen responsiva con placeholder.
 * - Con `image`: <Picture> optimizada (AVIF/WebP) vía astro:assets.
 * - Sin `image`: hueco con el color del diseño y el texto descriptivo,
 *   para maquetar antes de tener las fotos reales.
 * Sin `aspect` ocupa todo el contenedor padre (que debe tener posición y tamaño).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image?: ImageMetadata | undefined;
  alt: string;
  /** Relación de aspecto CSS, p. ej. "4/5". Si se omite, rellena al padre. */
  aspect?: string;
  fit?: 'cover' | 'contain';
  /** Punto de encuadre al recortar (object-position), p. ej. "top" o "50% 20%". */
  position?: string;
  shape?: 'rect' | 'circle';
  sizes?: string;
  widths?: number[];
  /** Imagen LCP: carga inmediata con prioridad alta. */
  priority?: boolean;
  /** Oculta el texto del placeholder (p. ej. avatares pequeños). */
  quiet?: boolean;
  class?: string;
}

const {
  image,
  alt,
  aspect,
  fit = 'cover',
  position,
  shape = 'rect',
  sizes = '100vw',
  widths = [480, 768, 1080, 1440, 1920],
  priority = false,
  quiet = false,
  class: className,
} = Astro.props;

const usableWidths = image ? widths.filter((w) => w <= image.width) : [];
if (image && usableWidths.length === 0) usableWidths.push(image.width);
---

<div
  class:list={['media', `media--${shape}`, `media--${fit}`, { 'media--fill': !aspect }, className]}
  style={[aspect && `aspect-ratio:${aspect}`, position && `--media-position:${position}`].filter(Boolean).join(';') || undefined}
>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={usableWidths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="media__img"
      />
    ) : (
      <div class="media__placeholder" role="img" aria-label={alt}>
        {!quiet && <span class="media__label">{alt}</span>}
      </div>
    )
  }
</div>

<style>
  .media {
    position: relative;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .media--fill {
    position: absolute;
    inset: 0;
  }

  .media--circle {
    border-radius: 50%;
  }

  .media :global(picture),
  .media :global(.media__img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .media--cover :global(.media__img) {
    object-fit: cover;
    object-position: var(--media-position, center);
  }

  .media--contain {
    background: transparent;
  }

  .media--contain :global(.media__img) {
    object-fit: contain;
  }

  .media__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(176 112 90 / 0.05) 14px 15px),
      linear-gradient(160deg, #ede3da 0%, var(--color-placeholder) 100%);
  }

  .media__label {
    max-width: 26ch;
    text-align: center;
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
</style>
