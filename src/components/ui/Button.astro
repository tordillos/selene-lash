---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'outline' | 'outline-light';
type Size = 'sm' | 'md';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: Variant;
  size?: Size;
  /** Ocupa todo el ancho del contenedor. */
  block?: boolean;
  /** Abre en pestaña nueva con rel seguro. */
  external?: boolean;
  /** Etiqueta de analítica para los CTA de reserva (se conserva del diseño). */
  bookingSlot?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  external = false,
  bookingSlot,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  data-booking-slot={bookingSlot}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-size: 12px;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition:
      background var(--duration) ease,
      border-color var(--duration) ease,
      color var(--duration) ease,
      transform var(--duration) ease;
  }

  .btn--sm {
    padding: 14px 26px;
    letter-spacing: 0.18em;
  }

  .btn--md {
    padding: 17px 32px;
  }

  .btn--block {
    display: flex;
    width: 100%;
    padding-inline: 26px;
    padding-block: 18px;
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn--primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .btn--outline {
    border-color: var(--color-border-strong);
    color: var(--color-text-muted);
  }

  .btn--outline:hover {
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
  }

  .btn--outline-light {
    border-color: rgb(255 249 245 / 0.55);
    color: var(--color-on-accent);
  }

  .btn--outline-light:hover {
    background: rgb(255 249 245 / 0.14);
    color: var(--color-on-accent);
  }
</style>
