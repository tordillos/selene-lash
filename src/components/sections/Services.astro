---
import BookingCard from '@/components/blocks/BookingCard.astro';
import ServiceCard from '@/components/blocks/ServiceCard.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { getSorted } from '@/lib/content';

const services = await getSorted('services');
---

<Section id="servicios" labelledby="servicios-title">
  <SectionHeader
    eyebrow="Servicios"
    title="Tratamientos de pestañas y cejas"
    titleId="servicios-title"
    lead="Cada tratamiento empieza con un diseño a medida de tu mirada: mapeamos forma de ojo, densidad y caída natural antes de tocar una sola pestaña."
  />

  <div class="services-grid">
    {services.map(({ data }) => <ServiceCard {...data} />)}
    <BookingCard />
  </div>
</Section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: clamp(22px, 3vw, 40px);
  }
</style>
