---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from './BaseLayout.astro';
import { site } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  updated?: string;
  noindex?: boolean;
}

const { title, description, updated, noindex } = Astro.props;
---

<BaseLayout title={`${title} | ${site.name}`} description={description ?? `${title} de ${site.name}.`} noindex={noindex}>
  <Section class="legal">
    <article class="legal__article">
      <Eyebrow>{site.name}</Eyebrow>
      <Heading as="h1" size="xl" class="legal__title">{title}</Heading>
      {updated && <p class="legal__updated">Última actualización: {updated}</p>}
      <div class="legal__body">
        <slot />
      </div>
    </article>
  </Section>
</BaseLayout>

<style>
  .legal__article {
    max-width: 72ch;
    padding-top: var(--header-h);
  }

  .legal__article :global(.legal__title) {
    margin-top: 18px;
  }

  .legal__updated {
    margin-top: 16px;
    font-size: 13px;
    color: var(--color-text-subtle);
  }

  .legal__body {
    margin-top: 40px;
    font-size: 16px;
    line-height: 1.75;
    font-weight: 300;
    color: var(--color-text-muted);
  }

  .legal__body :global(h2) {
    margin: 40px 0 12px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    color: var(--color-ink);
  }

  .legal__body :global(p + p) {
    margin-top: 14px;
  }
</style>
